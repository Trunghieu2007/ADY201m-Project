# Microsoft SQL Server connection examples for ADY201m
# Copy these values into your shell/session; do not commit real passwords.
ADY_SQLSERVER_SERVER=localhost
ADY_SQLSERVER_DATABASE=ADY201m
ADY_SQLSERVER_DRIVER=ODBC Driver 18 for SQL Server
ADY_SQLSERVER_TRUSTED_CONNECTION=yes
ADY_SQLSERVER_TRUST_SERVER_CERTIFICATE=yes
# For SQL authentication instead:
# ADY_SQLSERVER_TRUSTED_CONNECTION=no
# ADY_SQLSERVER_USERNAME=your_user
# ADY_SQLSERVER_PASSWORD=your_password
